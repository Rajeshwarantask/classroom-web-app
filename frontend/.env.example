# Public values embedded into the CRA browser bundle at build time.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional; defaults to the current origin + /auth/callback.
REACT_APP_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
